---
import Header from '@/components/Header.astro'
import Head from '@/layouts/components/Head.astro'
import Body from '@/layouts/components/Body.astro'
import Footer from '@/components/Footer.astro'
import NoticeModal from '@/components/NoticeModal.astro'
import '@/styles/global.scss'

export interface Props {
  title: string
  ogImage?: string
}

const { title, ogImage } = Astro.props
---

<html lang="ja">
  <Head title={title} ogImage={ogImage} />
  <Body>
    <Header />
    <NoticeModal client:load />
    <main>
      <article class="content">
        <div>
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </Body>
</html>
