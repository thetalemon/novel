---
import Header from '@/components/Header.astro'
import Head from '@/layouts/components/Head.astro'
import Body from '@/layouts/components/Body.astro'
import Footer from '@/components/Footer.astro'
import '@/styles/global.scss'
import { Image } from 'astro:assets'
import Clap from '@/img/clap.gif'

export interface Props {
  title: string
  ogImage?: string
}

const { title, ogImage } = Astro.props
---

<html lang="ja">
  <Head title={title} ogImage={ogImage} />
  <Body>
    <Header />
    <main>
      <article class="content">
        <div>
          <h1>{title}</h1>
          <div class="novel">
            <slot />
          </div>
        </div>
        <div class="link">
          <p>
            <a href="https://wavebox.me/wave/1zpw4z8irp585mvq/" target="_blank"
              ><Image src={Clap} alt="はくしゅ" height={16} /></a
            >
          </p>
          <p>
            <a href="/novel" target="_blank">一次創作トップ</a>
          </p>
        </div>
      </article>
    </main>
    <Footer />
  </Body>
</html>

<style lang="scss">
  h1 {
    text-align: center;
    margin-bottom: 40px;
  }
  hr {
    width: 100%;
    border: 1px #ccc solid;
  }
  p {
    margin: 2rem 0;
    line-height: 2;
  }
  .link {
    margin-top: 16px;
    text-align: center;
  }
</style>

<style lang="scss" is:global>
  img {
    max-width: 100%;
    height: auto;
  }
</style>
