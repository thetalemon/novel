---
import { styleHelper } from '@/utils/styleHelper'
import { COLORS_LIST } from '@/constants/colors'

const defaultColor = COLORS_LIST[0]

const STYLE = styleHelper([
  { name: 'bgColor', value: defaultColor.bgColor },
  { name: 'textColor', value: defaultColor.textColor },
  { name: 'linkColor', value: defaultColor.linkColor },
  { name: 'buttonColor', value: defaultColor.buttonColor },
])
---

<body style={STYLE}>
  <div class="color"></div>
  <slot />
</body>

<style lang="scss">
  .color {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    z-index: 9999;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      #e40303 0% 16.66%,
      #ff8c00 16.66% 33.33%,
      #ffed00 33.33% 50%,
      #008026 50% 66.66%,
      #004dff 66.66% 83.33%,
      #750787 83.33% 100%
    );
  }
</style>

<script type="module">
  function addKutenSpacing(root = document) {
    const containers = root.querySelectorAll('.md-content')
    const excludeTags = new Set([
      'A',
      'CODE',
      'PRE',
      'SCRIPT',
      'STYLE',
      'IMG',
      'TEXTAREA',
    ])

    containers.forEach((container) => {
      const walker = document.createTreeWalker(
        container,
        NodeFilter.SHOW_TEXT,
        null,
      )
      const toReplace = []
      while (walker.nextNode()) {
        const node = walker.currentNode
        const parentTag = node.parentElement && node.parentElement.tagName
        if (parentTag && excludeTags.has(parentTag)) continue
        if (node.nodeValue && node.nodeValue.includes('。'))
          toReplace.push(node)
      }

      toReplace.forEach((textNode) => {
        const parent = textNode.parentNode
        const parts = textNode.nodeValue.split(/(。)/)
        const frag = document.createDocumentFragment()
        for (let i = 0; i < parts.length; i++) {
          const part = parts[i]
          if (part === '。') {
            frag.appendChild(document.createTextNode('。'))
            const next = parts[i + 1] || ''
            if (next && !/^[\s\u3000]/.test(next)) {
              const span = document.createElement('span')
              span.className = 'ja-kuten-space'
              frag.appendChild(span)
            }
          } else if (part) {
            frag.appendChild(document.createTextNode(part))
          }
        }
        parent.replaceChild(frag, textNode)
      })
    })
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => addKutenSpacing())
    } else {
      addKutenSpacing()
    }
  }
</script>
