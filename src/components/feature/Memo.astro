---
import { getCollection } from 'astro:content'
import PostItem from '@/components/PostItem.astro'

const memoEntries = await getCollection('memo')
const sortedMemoEntries = memoEntries.sort(
  (a, b) =>
    new Date(String(b.data?.pubDate)).getTime() -
    new Date(String(a.data?.pubDate)).getTime(),
)
---

<div class="topMenu">
  <h2>memo</h2>
  <ul>
    {
      sortedMemoEntries.map((post) => (
        <PostItem
          href={`/memo/${post.id}`}
          title={post.data?.title}
          date={String(post.data?.pubDate)}
        />
      ))
    }
  </ul>
</div>
