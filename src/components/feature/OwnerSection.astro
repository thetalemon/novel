---
import { Image } from 'astro:assets'
import BannerImage from '@/img/banner.png'
---

<div class="inner owner">
  <dl>
    <dt>管理人</dt>
    <dd>まなさす</dd>
    <dt>SNS</dt>
    <dd>
      <a href="https://fedibird.com/@thetalemon/" target="_blank"> fedibird </a>
    </dd>
    <dt>サイト名</dt>
    <dd>北極の とある倉庫</dd>
    <dt>サイトアドレス</dt>
    <dd>https://novel.manasas.dev/</dd>
    <dt>バナー</dt>
    <dd><Image src={BannerImage} alt="バナー" /></dd>
