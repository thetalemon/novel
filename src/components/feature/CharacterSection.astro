---
import ListImage from '@/components/ListImage.astro'
import { yasuragiCharacterList } from '@/data/character/series/yasuragi'

const list = yasuragiCharacterList.map((item) => {
  return {
    path: `/character/${item.slug}/`,
    img: item.img,
    alt: item.name,
  }
})
---

<div class="root">
  <h2>キャラ一覧</h2>
  <ListImage list={list} />
</div>

<style lang="scss">
  .root {
    margin: 0 auto;
  }
</style>
