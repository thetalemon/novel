---
export interface Props {
  slug: string
  title: string
}

const { slug, title } = Astro.props
const path = `/novel/${slug}/`
---

{
  Astro.url.pathname === path ? (
    <li class="current">
      <p>{title}</p>
    </li>
  ) : (
    <li>
      <p>
        <a href={path}>{title}</a>
      </p>
    </li>
  )
}

<style lang="scss">
  li {
    p {
      margin: 0.5rem 0rem 0.5rem 1.25rem;
      font-size: 1rem;
    }

    &.current {
      p {
        display: flex;
        align-items: center;
        &::before {
          content: '';
          display: inline-block;
          background: rgb(var(--textColor));
          border-radius: 50%;
          width: 0.5rem;
          height: 0.5rem;
          flex-shrink: 0;
          margin-right: 8px;
        }
      }
    }
  }
</style>
