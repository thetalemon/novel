---
import SimpleLayout from '@/layouts/SimpleLayout.astro'
import { Image } from 'astro:assets'
import TitleLogo from '@/img/titleLogo.svg'
import { mySiteName } from '@/constants/constants'
import ImageLinkList from '@/components/ImageLinkList.astro'
import { SearchLinks } from '@/data/link/search'
import { DoumeiLinks } from '@/data/link/doumei'
---

<script>
  const KEY = 'noticeRead'
  document.addEventListener('DOMContentLoaded', () => {
    const el = document.querySelector<HTMLAnchorElement>('.enterButton')
    if (!el) return
    el.addEventListener('click', () => {
      try {
        localStorage.setItem(KEY, 'true')
      } catch (e) {}
    })
  })
</script>

<SimpleLayout title={mySiteName}>
  <h1 class="title">
    <Image src={TitleLogo} alt={mySiteName} height={75} />
  </h1>
  <div class="description">
    <p>まなさすの一次創作サイト。</p>
    <ul>
      <li>創作内にLGBTQ+要素を含みます</li>
    </ul>
  </div>
  <p class="enterArea">
    <a class="enterButton" href="/top">Enter</a>
  </p>
  <ImageLinkList list={SearchLinks} />
  <ImageLinkList list={DoumeiLinks} />
</SimpleLayout>

<style lang="scss">
  body {
    background: #0575e6;
    background: -webkit-linear-gradient(to top, #021b79, #0575e6);
    background: linear-gradient(to top, #021b79, #0575e6);
    background-attachment: fixed;
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center center;
  }

  .title {
    margin: 40px 0 0 0;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .description {
    text-align: center;
    color: #f5f5f5;
    p {
      color: #f5f5f5;
      margin: 0;
    }
    margin-top: 50px;
    ul {
      margin: 0 auto;
      margin-top: 8px;
      li {
        margin: 0.5rem 0.5rem;
        &::before {
          content: '・';
          margin-right: 0.5rem;
        }
        &::after {
          content: '・';
          margin-left: 0.5rem;
        }
      }
    }
  }

  .enterArea {
    display: flex;
    .enterButton {
      color: #fff;
      text-align: center;
      font-size: 36px;
      margin: 0 auto;
      padding: 1.5rem 80px;
      text-decoration: underline;
      &:hover {
        text-decoration: none;
      }
    }
  }
</style>
