---
import Layout from '@/layouts/Layout.astro'
import ListImage from '@/components/ListImage.astro'
import { RyuCharacterList } from '@/data/character/series/ryu'

const title = '龍の子'

const list = RyuCharacterList.map((item) => {
  return {
    path: `/character/${item.slug}/`,
    img: item.img,
    alt: item.name,
  }
})
---

<Layout
  title={title}
  ogImage={`https://novel.manasas.dev/og/novel/ryu-no-ko/ryu-no-ko.png`}
>
  <h1>{title}</h1>
  <h2>2024年辰年記念の小説</h2>
  <div class="novel">
    <ul>
      <li>
        <a href="/novel/ryu-no-ko/dragon-god"> 龍神様のはじまり </a>
      </li>
      <li>
        <a href="/novel/ryu-no-ko/sui"> スイの過去 </a>
      </li>
      <li>
        <a href="/novel/ryu-no-ko/momo"> モモの過去 </a>
      </li>
      <li>
        <a href="/novel/ryu-no-ko/momo-and-dragon"> モモと龍神様 </a>
      </li>
      <li>
        <a href="/novel/ryu-no-ko/dragon-new-year"> 龍と新年 </a>
      </li>
    </ul>
  </div>
  <h2>キャラ一覧</h2>
  <ListImage list={list} />
</Layout>

<style lang="scss">
  h1 {
    text-align: center;
    margin-bottom: 40px;
  }
  h2 {
    margin-top: 40px;
  }
  hr {
    width: 100%;
    border: 1px #ccc solid;
  }
</style>

<style lang="scss" is:global>
  .menu {
    margin-top: 40px;
  }
</style>
